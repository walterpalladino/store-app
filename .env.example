VITE_API_AUTH        =http://localhost:3000
VITE_API_USERS       =http://localhost:3000
VITE_API_PRODUCTS    =http://localhost:3000
VITE_API_CARTS       =http://localhost:3000
VITE_API_TRANSACTIONS=http://localhost:3000

# Stripe hosted checkout — where Stripe redirects the browser back to after the
# payment page. VITE_PUBLIC_APP_URL is this front end's public origin, used to
# build the success/cancel URLs; leave unset to use the current browser origin
# (fine for local dev). Set it for deployments served behind a fixed public URL.
# VITE_PUBLIC_APP_URL=https://shop.example
# Optionally pin the full callback URLs instead of deriving them from the origin:
# VITE_CHECKOUT_SUCCESS_URL=https://shop.example/checkout/return
# VITE_CHECKOUT_CANCEL_URL=https://shop.example/checkout/cancel

# Logging verbosity: silent | error | warn | info | debug
# Unset → "debug" in dev, "error" in production builds.
VITE_LOG_LEVEL=debug

# Also mirror logs to the dev-server terminal (where `npm run dev` runs), not
# just the browser console. Requires vite-plugin-terminal. true | false
VITE_LOG_TO_SERVER=true
